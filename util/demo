#!/usr/bin/env bash

set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
goyaml=${GO_YAML_CLI:-$root/.cache/integration/source/go-yaml}
yamlstar=${YAMLSTAR_CLI:-yaml}
if [[ -z ${YAMLSTAR_CLI:-} && -f $root/.cache/integration/yamlstar-path ]]; then
  IFS= read -r yamlstar < "$root/.cache/integration/yamlstar-path"
fi
export YAMLSTAR_LIBRARY_PATH=$root/lib
unset YAMLSTAR_CSV_FORMAT

for binary in "$goyaml" "$yamlstar"; do
  if ! command -v "$binary" >/dev/null 2>&1; then
    echo "Missing demo executable: $binary" >&2
    echo 'Set GO_YAML_CLI and YAMLSTAR_CLI to the demo executables.' >&2
    exit 1
  fi
done

if ! output=$("$yamlstar" --plugin=yaml-parser=csv --no-install -j \
  example/services.csv 2>&1); then
  echo "YAMLStar CSV check failed: $(command -v "$yamlstar")" >&2
  printf '%s\n' "$output" >&2
  echo 'Set YAMLSTAR_CLI to a CSV-enabled build, then run make test-integration.' >&2
  exit 1
fi

run() {
  printf '\n$'
  local argument
  for argument in "$@"; do
    case $argument in
      "$goyaml") argument=go-yaml ;;
      "$yamlstar") argument=yaml ;;
    esac
    printf ' %q' "$argument"
  done
  printf '\n'
  "$@"
}

run cat src/csv_parser/core.ys
run cat example/services.csv
run "$goyaml" --plugin=yaml-parser=csv -y example/services.csv
run "$goyaml" --plugin=yaml-parser=csv -j example/services.csv
run "$yamlstar" --plugin=yaml-parser=csv --no-install -y example/services.csv
run "$yamlstar" --plugin=yaml-parser=csv --no-install -j example/services.tsv
run env YAMLSTAR_CSV_FORMAT=tsv \
  "$goyaml" --plugin=yaml-parser=csv -j example/services.tsv
run "$goyaml" --config=example/rows.yaml -j example/services.csv
