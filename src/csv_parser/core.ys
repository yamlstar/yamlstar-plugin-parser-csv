!ys-0

# The adapter supplies a fresh encoding/csv.Reader for each call.
defn parse(reader text config environment):
  options =: parse-options(config environment)
  format =: options.format
  format :if (format == 'auto') =: detect-format(text)
  separator =:
    if format == 'tsv': \\tab \\,
  set!: (. reader Comma) separator:go/rune
  rows error =: (. reader ReadAll)
  when error:
    throw: error
  rows =: rows.mapv(vec)
  header =: options.header
  when header && rows.?:
    validate-header: rows.0
  records =: header.if(rows:rest rows)
  body =:
    mapcat _ records:
      fn(row):
        if header:
          mapping-events: rows.0 row
          collection-events 'sequence': row.map(scalar-event)
  prefix =: :[event('stream_start') event('document_start')]
  suffix =: :[event('document_end') event('stream_end')]
  vec: prefix + collection-events('sequence' body) + suffix

defn parse-options(config environment):
  when-not config:map?:
    fail: 'configuration must be a mapping'
  unknown =: remove(\(_.in?([:format :header])) config:keys)
  when unknown:seq:
    fail: "unknown configuration keys $pr-str(unknown)"
  environment :if environment:nil? =: 'auto'
  format =: config.contains?(:format).if(config.format environment)
  when-not format.in?(qw(csv tsv auto)):
    fail: 'format must be csv, tsv, or auto'
  header =: config.contains?(:header).if(config.header true)
  when-not header:boolean?:
    fail: 'header must be a boolean'
  =>:::
    :format: format
    :header: header

defn- detect-format(text):
  loop chars text:seq, quoted false, started false, found \{}:
    if chars:empty?:
      select-format: found
      else:
        c =: chars:first
        cond:
          c == C(34):
            recur: chars:rest, quoted:not, true, found
          quoted:
            recur: chars:rest, quoted, true, found
          c == \\newline:
            if started:
              select-format: found
              recur: chars:rest, false, false, found
          c.in?([\\, \\tab]):
            recur: chars:rest, false, true, found.conj(c)
          else:
            recur: chars:rest, false, (started || (c != C(13))), found

defn- select-format(found):
  when found.# > 1:
    fail: 'ambiguous delimiter; set format to csv or tsv'
  found.has?(\\tab): .if('tsv' 'csv')

defn- validate-header(header):
  when header.has?(''):
    fail: 'header names must not be empty'
  when header.# != header:distinct:count:
    fail: 'header names must be unique'

defn- mapping-events(header row):
  fields =: interleave(header row).map(scalar-event)
  collection-events 'mapping': fields

defn- collection-events(kind items):
  +[event("${kind}_start").put(:flow false)] +
  items +
  [event("${kind}_end")]

defn- scalar-event(value)::
  :event: scalar
  :tag: tag:yaml.org,2002:str
  :value:: value

defn- event(kind)::
  :event:: kind

defn- fail(message):
  throw: ex-info(message {})
